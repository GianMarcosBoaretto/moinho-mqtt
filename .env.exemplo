# Modelo do arquivo de segredos. Copie para .env e troque os valores,
# ou rode scripts/preparar_segredos.py, que cria o .env com senhas aleatorias.
# O .env NUNCA vai para o Git (esta no .gitignore).

# senha do usuario no-moinho01 no broker MQTT (simulador / ESP32)
MQTT_SENHA_NO=troque-esta-senha

# senha do usuario supervisorio no broker MQTT (backend)
MQTT_SENHA_SUPERVISORIO=troque-esta-senha

# chave que o celular envia no cabecalho Authorization para usar a API /api/gateway
GATEWAY_TOKEN=troque-esta-chave
